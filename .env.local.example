# ---------------------------------------------------------------------------
# Required — Supabase. Dashboard → Project Settings → API.
# The anon key is meant to be public; row-level security does the enforcing.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional — Google Calendar import.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Enable the Google Calendar API on the project.
# Add this authorised redirect URI:
#   http://localhost:3000/api/google/callback
# and the equivalent on your deployed domain.
#
# These two are server-only — no NEXT_PUBLIC_ prefix, so they never reach
# the browser bundle.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set in production so the OAuth redirect URI matches your real domain
# instead of being inferred from the incoming request.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Calendly needs no server config — each user connects by pasting their own
# personal access token on the Integrations page.
# ---------------------------------------------------------------------------
